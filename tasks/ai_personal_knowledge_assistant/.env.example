# Copy to .env and fill in what you need. Every key is optional; the values shown
# are the defaults. Relative paths are resolved against this project folder.

# --- OpenAI (required for /chat/ask and /agent/chat; upload and list work without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Relational DB: SQLite by default ---
# MySQL example (needs `uv sync --extra mysql`): mysql+pymysql://user:pass@localhost:3306/pka
DATABASE_URL=sqlite:///data/app.db

# --- Vector store / files ---
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=documents
UPLOAD_DIR=data/uploads
# Largest accepted upload, in megabytes
MAX_UPLOAD_MB=10

# --- RAG tuning ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Chunk length and overlap in characters; CHUNK_OVERLAP must be smaller than CHUNK_SIZE
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# Number of chunks retrieved per question
TOP_K=5
# Cosine similarity (0..1) a chunk needs to count as evidence
MIN_RELEVANCE=0.30

# --- Agent ---
# Tool-calling rounds before the agent gives up
AGENT_MAX_ROUNDS=6
# Past messages of a chat session sent back to the model
CHAT_HISTORY_LIMIT=20

# --- API server (uv run pka-api) ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Frontend (uv run pka-ui): where the UI finds the API ---
API_BASE_URL=http://127.0.0.1:8000

# --- Optional OCR for scanned PDFs (needs `uv sync --extra ocr` plus tesseract and poppler) ---
OCR_ENABLED=false

# --- Logging: DEBUG, INFO, WARNING, ERROR or CRITICAL ---
LOG_LEVEL=INFO
