# Copy to .env and fill in. Only DATABASE_URL is required; the other values shown
# are the defaults. Relative paths are resolved against this project folder.
# Never commit .env.

# --- MySQL (required). Create the database first: CREATE DATABASE travel_ai; ---
DATABASE_URL=mysql+pymysql://travel_ai_user:change-me@127.0.0.1:3306/travel_ai

# --- Language model (needed by the chatbot; browsing and booking work without it) ---
# Any OpenAI-compatible Chat Completions API with tool calling. Examples:
#   OpenAI:  OPENAI_API_KEY=sk-...           OPENAI_MODEL=gpt-4o-mini (or gpt-4.1-mini)
#   Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=llama3.2
#   Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_API_KEY=gsk_...
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings (needed by document indexing and policy answers) ---
# Default to the language-model provider above. To keep OpenAI embeddings while
# chatting with another provider, set EMBEDDING_API_KEY (and EMBEDDING_BASE_URL
# for a non-OpenAI embedder, e.g. Ollama with nomic-embed-text).
# Changing the embedding model requires re-indexing: delete CHROMA_PATH and run
# travel-index again.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Documents and vector store ---
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=policy_documents
UPLOAD_DIR=data/uploads
# Folder `travel-index` loads the starter policy documents from
KNOWLEDGE_BASE_DIR=knowledge_base
# Largest accepted upload, in megabytes
MAX_UPLOAD_MB=10

# --- RAG tuning ---
# Chunk length and overlap in characters; CHUNK_OVERLAP must be smaller than CHUNK_SIZE
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# Chunks retrieved per question
TOP_K=4
# Cosine similarity (0..1) a chunk needs to count as evidence
MIN_RELEVANCE=0.3

# --- Agent and chat ---
# Where the agent's tools reach this API. Leave empty to use
# http://127.0.0.1:API_PORT; only set it behind a proxy, and keep it local.
INTERNAL_API_BASE_URL=
# Tool-calling rounds before the agent gives up
AGENT_MAX_ITERATIONS=6
TOOL_TIMEOUT_SECONDS=10
# How long a booking/cancel waiting for confirmation stays valid
PENDING_ACTION_TTL_MINUTES=15
# Most recent messages of a session sent to the model
CHAT_CONTEXT_TURNS=12
# Chat messages a user may send per minute
CHAT_RATE_LIMIT_PER_MINUTE=20

# --- API server (uv run travel-api) ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Logging: DEBUG, INFO, WARNING, ERROR or CRITICAL ---
LOG_LEVEL=INFO

# --- Tests only (uv run pytest): a separate, empty MySQL database that the
# integration tests create tables in and wipe. Never point it at real data.
# Unset: the database tests are skipped and only the unit tests run.
# TEST_DATABASE_URL=mysql+pymysql://travel_ai_user:change-me@127.0.0.1:3306/travel_ai_test
