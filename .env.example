DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=genaib3
# Optional, read by the FastAPI apps only (the CLI programs always use 3306).
# Set it when your MySQL listens on another port, e.g. a hosted database.
DB_PORT=3306

# Optional, read by the student_ms and hotel_room_bs FastAPI apps' chat assistant (POST /chat).
# Without a key the rest of each app still works; only the chat says it isn't set up.
OPENAI_API_KEY=
# Optional; defaults to gpt-5.4-mini.
OPENAI_MODEL=

# Optional, read by the student_ms and hotel_room_bs FastAPI apps' chat assistant (POST /chat).
# true/1/yes uses a local Ollama model instead of OpenAI (no OPENAI_API_KEY needed);
# false or unset uses OpenAI.
OLLAMA_ENABLED=true
# Optional; defaults to Ollama's OpenAI-compatible endpoint on its default port.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional; defaults to llama3.2. Pull it first with `ollama pull llama3.2`.
OLLAMA_MODEL=llama3.2
