DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=genaib3
# Optional, read by the FastAPI apps only (the CLI programs always use 3306).
# Set it when your MySQL listens on another port, e.g. a hosted database.
DB_PORT=3306

# Optional, read by the student_ms FastAPI app's chat assistant (POST /chat).
# Without a key the student API still works; only the chat says it isn't set up.
OPENAI_API_KEY=
# Optional; defaults to gpt-5.4-mini.
OPENAI_MODEL=
